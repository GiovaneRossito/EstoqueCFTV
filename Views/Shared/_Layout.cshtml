@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EstoqueCFTV</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* ===== BARRA DE NAVEGAÇÃO: um link para cada Controller ===== *@
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-cftv">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">EstoqueCFTV</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "Produto" ? "active" : "")" asp-controller="Produto" asp-action="Index">Produtos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "Categoria" ? "active" : "")" asp-controller="Categoria" asp-action="Index">Categorias</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "MovimentacaoEstoque" ? "active" : "")" asp-controller="MovimentacaoEstoque" asp-action="Index">Movimentações</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "Cliente" ? "active" : "")" asp-controller="Cliente" asp-action="Index">Clientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "OrdemDeServico" ? "active" : "")" asp-controller="OrdemDeServico" asp-action="Index">Ordens de Serviço</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "Servico" ? "active" : "")" asp-controller="Servico" asp-action="Index">Serviços</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "ItemServicoOS" ? "active" : "")" asp-controller="ItemServicoOS" asp-action="Index">Itens da OS</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerAtual == "Usuario" ? "active" : "")" asp-controller="Usuario" asp-action="Index">Usuários</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* ===== CONTEÚDO DA PÁGINA ===== *@
    <main role="main" class="container py-4 flex-grow-1">
        @* Mensagem de erro enviada pelas Controllers (ex.: exclusão não permitida) *@
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Erro"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        }

        @RenderBody()
    </main>

    @* ===== RODAPÉ ===== *@
    <footer>
        <div class="container">
            &copy; @DateTime.Now.Year - EstoqueCFTV - Controle de estoque para segurança eletrônica
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
