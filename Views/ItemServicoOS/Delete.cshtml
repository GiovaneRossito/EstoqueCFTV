@model ItemServicoOS
@{
    ViewData["Title"] = "Excluir item da OS";
}

<div class="row">
    <div class="col-lg-8">
        <div class="painel-cftv">
            <h1 class="h4 mb-3">Excluir item da OS</h1>
            <p>Confirma a exclusão do registro abaixo? Esta ação não pode ser desfeita.</p>

            <dl class="row mb-4">
            <dt class="col-sm-4 col-md-3">Ordem de serviço</dt>
            <dd class="col-sm-8 col-md-9">@Model.OrdemDeServicoId</dd>
            <dt class="col-sm-4 col-md-3">Serviço</dt>
            <dd class="col-sm-8 col-md-9">@(Model.Servico?.Nome ?? "—")</dd>
            <dt class="col-sm-4 col-md-3">Quantidade</dt>
            <dd class="col-sm-8 col-md-9">@Model.Quantidade</dd>
            <dt class="col-sm-4 col-md-3">Valor cobrado</dt>
            <dd class="col-sm-8 col-md-9">@Model.ValorCobrado.ToString("C")</dd>
            <dt class="col-sm-4 col-md-3">Subtotal</dt>
            <dd class="col-sm-8 col-md-9">@((Model.Quantidade * Model.ValorCobrado).ToString("C"))</dd>
            </dl>

            <form asp-action="Delete" asp-route-ordemDeServicoId="@Model.OrdemDeServicoId" asp-route-servicoId="@Model.ServicoId" method="post" class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Excluir</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
