@model Usuario
@{
    ViewData["Title"] = "Novo usuário";
}

<div class="row">
    <div class="col-lg-8">
        <div class="painel-cftv">
            <h1 class="h4 mb-4">Novo usuário</h1>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label">Nome</label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">E-mail</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Perfil" class="form-label">Perfil</label>
                        <input asp-for="Perfil" class="form-control" value="@(Model?.Perfil ?? "Tecnico")" />
                        <span asp-validation-for="Perfil" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SenhaHash" class="form-label">Senha</label>
                        <input asp-for="SenhaHash" type="password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="SenhaHash" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-cftv">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
