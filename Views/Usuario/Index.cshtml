@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuários";
}

<div class="painel-cftv">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Usuários</h1>
        <a asp-action="Create" class="btn btn-cftv">Novo usuário</a>
    </div>

    <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
        <div class="col-md-5">
            <label for="busca" class="form-label mb-1">Buscar por Nome ou E-mail</label>
            <input type="text" id="busca" name="busca" value="@ViewBag.BuscaAtual" class="form-control" />
        </div>
        <div class="col-md-3">
            <label for="perfil" class="form-label mb-1">Perfil</label>
            <select id="perfil" name="perfil" class="form-select">
                <option value="">Todos</option>
                <option value="Administrador" selected="@(ViewBag.PerfilAtual == "Administrador")">Administrador</option>
                <option value="Tecnico" selected="@(ViewBag.PerfilAtual == "Tecnico")">Técnico</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-cftv w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <p class="mb-0">Nenhum usuário cadastrado ainda. Use o botão acima para cadastrar o primeiro.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>E-mail</th>
                        <th>Perfil</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.Email</td>
                            <td><span class="badge badge-destaque">@item.Perfil</span></td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
