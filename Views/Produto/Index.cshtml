@model IEnumerable<Produto>
@{
    ViewData["Title"] = "Produtos";
}

<div class="painel-cftv">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Produtos</h1>
        <a asp-action="Create" class="btn btn-cftv">Novo produto</a>
    </div>

    <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label for="busca" class="form-label mb-1">Buscar por Nome ou SKU</label>
            <input type="text" id="busca" name="busca" value="@ViewBag.BuscaAtual" class="form-control" placeholder="Ex: Câmera, CAM-BUL..." />
        </div>
        <div class="col-md-3">
            <label for="categoriaId" class="form-label mb-1">Categoria</label>
            <select id="categoriaId" name="categoriaId" class="form-select">
                <option value="">Todas as categorias</option>
                @if (ViewBag.Categorias != null)
                {
                    foreach (SelectListItem cat in ViewBag.Categorias)
                    {
                        var selecionado = ViewBag.CategoriaAtual != null && ViewBag.CategoriaAtual.ToString() == cat.Value;
                        <option value="@cat.Value" selected="@selecionado">@cat.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="somenteEstoqueBaixo" name="somenteEstoqueBaixo" value="true" checked="@(ViewBag.SomenteEstoqueBaixo == true)" />
                <label class="form-check-label" for="somenteEstoqueBaixo">Somente estoque baixo</label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-cftv w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>

    @{
        var totalBaixo = Model.Count(p => p.QuantidadeEstoque <= p.QuantidadeMinima);
    }
    @if (totalBaixo > 0)
    {
        <p class="mb-3"><span class="badge badge-alerta">@totalBaixo</span> produto(s) com estoque baixo</p>
    }

    @if (!Model.Any())
    {
        <p class="mb-0">Nenhum produto encontrado para o filtro informado.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Nome</th>
                        <th>Categoria</th>
                        <th>Preço</th>
                        <th>Estoque</th>
                        <th>Mínimo</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var estoqueBaixo = item.QuantidadeEstoque <= item.QuantidadeMinima;
                        <tr class="@(estoqueBaixo ? "estoque-baixo" : "")">
                            <td>@item.SKU</td>
                            <td>@item.Nome</td>
                            <td>@(item.Categoria?.Nome ?? "—")</td>
                            <td>@item.PrecoUnitario.ToString("C")</td>
                            <td>@item.QuantidadeEstoque @item.UnidadeMedida</td>
                            <td>@item.QuantidadeMinima</td>
                            <td>@if (estoqueBaixo) { <span class="badge badge-alerta">Estoque baixo</span> } else { <span class="badge badge-sucesso">Estoque OK</span> }</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>