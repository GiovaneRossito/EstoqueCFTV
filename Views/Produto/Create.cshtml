@model Produto
@{
    ViewData["Title"] = "Novo produto";
}

<div class="row">
    <div class="col-lg-8">
        <div class="painel-cftv">
            <h1 class="h4 mb-4">Novo produto</h1>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Nome" class="form-label">Nome</label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SKU" class="form-label">SKU</label>
                        <input asp-for="SKU" class="form-control" />
                        <span asp-validation-for="SKU" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="CategoriaId" class="form-label">Categoria</label>
                        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                            <option value="">Selecione...</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="UnidadeMedida" class="form-label">Unidade de medida</label>
                        <input asp-for="UnidadeMedida" class="form-control" list="unidades" value="@(Model?.UnidadeMedida ?? "UN")" />
                        <span asp-validation-for="UnidadeMedida" class="text-danger"></span>
                    </div>
                    <datalist id="unidades">
                        <option value="UN"></option>
                        <option value="CX"></option>
                        <option value="M"></option>
                        <option value="RL"></option>
                        <option value="KIT"></option>
                    </datalist>
                    <div class="col-md-4">
                        <label asp-for="PrecoUnitario" class="form-label">Preço unitário</label>
                        <input asp-for="PrecoUnitario" class="form-control" inputmode="decimal" />
                        <span asp-validation-for="PrecoUnitario" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="QuantidadeEstoque" class="form-label">Quantidade em estoque</label>
                        <input asp-for="QuantidadeEstoque" class="form-control" placeholder="0" />
                        <span asp-validation-for="QuantidadeEstoque" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="QuantidadeMinima" class="form-label">Quantidade mínima</label>
                        <input asp-for="QuantidadeMinima" class="form-control" placeholder="0" />
                        <span asp-validation-for="QuantidadeMinima" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-cftv">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
