@model IEnumerable<MovimentacaoEstoque>
@{
    ViewData["Title"] = "Movimentações de estoque";
}

<div class="painel-cftv">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Movimentações de estoque</h1>
        <a asp-action="Create" class="btn btn-cftv">Nova movimentação</a>
    </div>

    <form method="get" asp-action="Index" class="row g-2 align-items-end mb-4">
        <div class="col-md-3">
            <label for="busca" class="form-label mb-1">Observação, Cliente ou Usuário</label>
            <input type="text" id="busca" name="busca" value="@ViewBag.BuscaAtual" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="produtoId" class="form-label mb-1">Produto</label>
            <select id="produtoId" name="produtoId" class="form-select">
                <option value="">Todos</option>
                @foreach (SelectListItem p in ViewBag.Produtos)
                {
                    <option value="@p.Value" selected="@(ViewBag.ProdutoAtual != null && ViewBag.ProdutoAtual.ToString() == p.Value)">@p.Text</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <label for="tipo" class="form-label mb-1">Tipo</label>
            <select id="tipo" name="tipo" class="form-select">
                <option value="">Todos</option>
                <option value="Entrada" selected="@(ViewBag.TipoAtual == TipoMovimentacao.Entrada)">Entrada</option>
                <option value="Saida" selected="@(ViewBag.TipoAtual == TipoMovimentacao.Saida)">Saída</option>
            </select>
        </div>
        <div class="col-md-2">
            <label for="dataInicial" class="form-label mb-1">De</label>
            <input type="date" id="dataInicial" name="dataInicial" value="@ViewBag.DataInicial" class="form-control" />
        </div>
        <div class="col-md-2">
            <label for="dataFinal" class="form-label mb-1">Até</label>
            <input type="date" id="dataFinal" name="dataFinal" value="@ViewBag.DataFinal" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-cftv w-100">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
        </div>
    </form>

    @if (!Model.Any())
    {
        <p class="mb-0">Nenhuma movimentação registrada ainda. Use o botão acima para registrar a primeira.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Produto</th>
                        <th>Tipo</th>
                        <th>Quantidade</th>
                        <th>Usuário</th>
                        <th>Cliente</th>
                        <th>Observação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DataMovimentacao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.Produto?.Nome ?? "—")</td>
                            <td><span class="badge @(item.Tipo == TipoMovimentacao.Entrada ? "badge-sucesso" : "badge-destaque")">@(item.Tipo == TipoMovimentacao.Entrada ? "Entrada" : "Saída")</span></td>
                            <td><span class="@(item.Tipo == TipoMovimentacao.Entrada ? "qtd-entrada" : "qtd-saida")">@(item.Tipo == TipoMovimentacao.Entrada ? "+" : "−")@item.Quantidade</span> @item.Produto?.UnidadeMedida</td>
                            <td>@(item.Usuario?.Nome ?? "—")</td>
                            <td>@(item.Cliente?.Nome ?? "—")</td>
                            <td>@(item.Observacao ?? "—")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
