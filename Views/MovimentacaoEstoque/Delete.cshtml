@model MovimentacaoEstoque
@{
    ViewData["Title"] = "Excluir movimentação";
}

<div class="row">
    <div class="col-lg-8">
        <div class="painel-cftv">
            <h1 class="h4 mb-3">Excluir movimentação</h1>
            <p>Confirma a exclusão do registro abaixo? Esta ação não pode ser desfeita. O estoque do produto será ajustado, desfazendo o efeito desta movimentação.</p>

            <dl class="row mb-4">
            <dt class="col-sm-4 col-md-3">Data</dt>
            <dd class="col-sm-8 col-md-9">@Model.DataMovimentacao.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4 col-md-3">Produto</dt>
            <dd class="col-sm-8 col-md-9">@(Model.Produto?.Nome ?? "—")</dd>
            <dt class="col-sm-4 col-md-3">Tipo</dt>
            <dd class="col-sm-8 col-md-9"><span class="badge @(Model.Tipo == TipoMovimentacao.Entrada ? "badge-sucesso" : "badge-destaque")">@(Model.Tipo == TipoMovimentacao.Entrada ? "Entrada" : "Saída")</span></dd>
            <dt class="col-sm-4 col-md-3">Quantidade</dt>
            <dd class="col-sm-8 col-md-9">@Model.Quantidade @Model.Produto?.UnidadeMedida</dd>
            <dt class="col-sm-4 col-md-3">Usuário</dt>
            <dd class="col-sm-8 col-md-9">@(Model.Usuario?.Nome ?? "—")</dd>
            <dt class="col-sm-4 col-md-3">Cliente</dt>
            <dd class="col-sm-8 col-md-9">@(Model.Cliente?.Nome ?? "—")</dd>
            <dt class="col-sm-4 col-md-3">Observação</dt>
            <dd class="col-sm-8 col-md-9">@(Model.Observacao ?? "—")</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Excluir</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
